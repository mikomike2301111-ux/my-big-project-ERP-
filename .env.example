# Cloudflare D1 (primary database)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=
CLOUDFLARE_D1_DATABASE_NAME=erpftc_full
CLOUDFLARE_API_TOKEN=

# Email (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_REPLY_TO=
OFFICE_ADMIN_EMAIL=kiarieadmin@gmail.com

# AI (optional)
OPENROUTER_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# App
PLATFORM_URL=https://erpftc.vercel.app
APP_BASE_URL=

# Save-speed (api/rpc.js + server/d1Client.js):
#   - Normalized table-level writes for hot records (invoices/payments/expenses/
#     requisitions/calls) + coalescing of concurrent full-state saves are ON by
#     default and are best-effort / never replace the authoritative erp_state
#     document write. Set to 1 to disable the normalized add-on path entirely.
# NORMALIZED_WRITES_DISABLED=0
# FAST_SAVE_DISABLE=0

# Legacy Supabase — DO NOT USE (removed from Vercel; kept commented for reference only)
# SUPABASE_URL=
# SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_SECRET_KEY=
