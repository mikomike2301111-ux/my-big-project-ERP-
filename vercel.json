{
  "version": 2,
  "framework": "vite",
  "buildCommand": "node scripts/apply-hr-delete-xai.js; node scripts/apply-d1-rpc-patch.js; node scripts/apply-role-pages-email-links.js; node scripts/apply-keeper-prune.js; node --max-old-space-size=4096 ./node_modules/vite/bin/vite.js build",
  "outputDirectory": "dist",
  "installCommand": "npm ci --registry=https://registry.npmjs.org --fetch-retries=5 --fetch-retry-mintimeout=20000 --fetch-retry-maxtimeout=120000",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/rpc.js": { "maxDuration": 60, "memory": 1024 },
    "api/ai-assistant.js": { "maxDuration": 60 },
    "api/**/*.js": { "maxDuration": 60, "memory": 1024 }
  },
  "crons": [
    { "path": "/api/backup-weekly", "schedule": "0 2 * * 0" }
  ]
}
